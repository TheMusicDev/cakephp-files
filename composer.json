{
    "name": "themusicdev/files",
    "description": "CakePHP 5 plugin: reusable uploads and file management with Flysystem v3 storage, a stored_files ledger, collections (virtual folders) and gated serving",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "plugin", "uploads", "files", "flysystem", "file-management", "storage"],
    "homepage": "https://github.com/TheMusicDev/cakephp-files",
    "license": "MIT",
    "authors": [
        {
            "name": "TheMusicDev",
            "homepage": "https://themusicdev.llc"
        }
    ],
    "support": {
        "issues": "https://github.com/TheMusicDev/cakephp-files/issues",
        "source": "https://github.com/TheMusicDev/cakephp-files"
    },
    "require": {
        "php": ">=8.2",
        "ext-fileinfo": "*",
        "cakephp/cakephp": "^5.2",
        "league/flysystem": "^3.0",
        "league/flysystem-local": "^3.0"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.3",
        "cakephp/migrations": "^5.0",
        "captainhook/captainhook": "^5.29",
        "captainhook/plugin-composer": "^5.3",
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^11.5.3 || ^12.1.3 || ^13.0",
        "ramsey/conventional-commits": "^1.7"
    },
    "suggest": {
        "cakephp/migrations": "Needed to create the stored_files table (bin/cake migrations migrate -p TheMusicDev/Files)",
        "league/flysystem-aws-s3-v3": "To store files on S3 instead of the local disk"
    },
    "autoload": {
        "psr-4": {
            "TheMusicDev\\Files\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TheMusicDev\\Files\\Test\\": "tests/",
            "TestApp\\": "tests/test_app/src/"
        }
    },
    "scripts": {
        "check": [
            "@test",
            "@cs-check",
            "@stan"
        ],
        "cs-check": "phpcs --colors -p",
        "cs-fix": "phpcbf --colors -p",
        "stan": "phpstan analyse --no-progress --memory-limit=512M",
        "test": "phpunit --colors=always"
    },
    "config": {
        "allow-plugins": {
            "captainhook/plugin-composer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cakephp/plugin-installer": true
        },
        "sort-packages": true
    }
}
